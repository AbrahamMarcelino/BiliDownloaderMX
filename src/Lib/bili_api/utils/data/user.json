        "code": {
          "0": "Éxito",
          "86038": "Clave caducada",
          "86101": "Sin escanear",
          "86090": "Sin confirmar"
        }
      }
    }
  },
  "get_login_url_old": {
    "url": "https://passport.bilibili.com/qrcode/getLoginUrl",
    "method": "GET",
    "verify": false,
    "params": null,
    "return": {
      "code": {
        "0": "Éxito"
      },
      "status": true,
      "ts": "Hora de la solicitud num",
      "data": {
        "url": "URL del contenido del código QR string",
        "oauthKey": "Clave de inicio de sesión por QR string"
      }
    }
  },
  "get_login_data_old": {
    "url": "https://passport.bilibili.com/qrcode/getLoginInfo",
    "method": "POST",
    "verify": false,
    "params": {
      "oauthKey": "Clave de inicio de sesión por QR string",
      "gourl": "URL de redirección string (opcional)"
    },
    "return": {
      "code": "Valor devuelto num",
      "message": "Mensaje de error",
      "ts": "Hora del escaneo",
      "status": "Si el inicio de sesión por QR tuvo éxito bool",
      "data": {
        "obj": "Éxito",
        "-1": "Clave incorrecta",
        "-2": "Clave caducada",
        "-4": "Sin escanear",
        "-5": "Sin confirmar"
      }
    }
  },
  "nav": {
    "url": "https://api.bilibili.com/x/web-interface/nav",
    "method": "GET",
    "verify": true,
    "params": null,
    "return": {
      "code": {
        "0": "Éxito",
